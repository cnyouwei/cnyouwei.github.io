{% extends 'base.html.j2' %}

{% block main %}
    <article class="section post">
      <div class="container post-layout">
        <header class="post-header">
          <p><a class="chip" href="../index.html#blog">&larr; All posts</a></p>
          <h1>{{ post.title }}</h1>
          <p class="post-meta">
            <time datetime="{{ post.date }}">{{ post.date_label }}</time>
            {% for tag in post.tags %}
            <span class="blog-tag">{{ tag }}</span>
            {% endfor %}
          </p>
          <p class="post-summary">{{ post.summary }}</p>
        </header>
        {% if post.toc %}
        <details class="post-toc">
          <summary>On this page</summary>
          <nav aria-label="Table of contents">
            <ul>
              {% for entry in post.toc %}
              <li class="post-toc__item{{ ' post-toc__item--sub' if entry.level >= 3 else '' }}">
                <a href="#{{ entry.id }}">{{ entry.title }}</a>
              </li>
              {% endfor %}
            </ul>
          </nav>
        </details>
        {% endif %}
        <div class="post-body">
{{ post.body_html | safe }}
        </div>
      </div>
    </article>
{% endblock %}
