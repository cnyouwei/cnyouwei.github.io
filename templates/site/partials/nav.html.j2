{% set home = '' if page_id == 'home' else root ~ 'index.html' %}
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="{{ home }}#home" aria-label="Go to home">{{ profile.name }}</a>
      <div class="nav-controls">
        <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" hidden>
          <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2.5V5.1M12 18.9V21.5M2.5 12H5.1M18.9 12H21.5M5.2 5.2L7 7M17 17L18.8 18.8M17 7L18.8 5.2M5.2 18.8L7 17"></path>
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20.4 14.2a8.7 8.7 0 0 1-10.6-10.6A9.5 9.5 0 1 0 20.4 14.2z"></path>
          </svg>
        </button>
        <button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="site-nav" aria-expanded="false" hidden>
          <span></span>
          <span></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <a class="nav-link" href="{{ home }}#home">Home</a>
          <a class="nav-link" href="{{ home }}#research">Research</a>
          <a class="nav-link" href="{{ home }}#talks">Talks</a>
          <a class="nav-link" href="{{ home }}#teaching">Teaching</a>
          <a class="nav-link" href="{{ home }}#team">Team</a>
          <a class="nav-link" href="{{ home }}#about">About</a>
          <a class="nav-link" href="{{ home }}#blog">Blog</a>
        </nav>
      </div>
    </div>
  </header>
