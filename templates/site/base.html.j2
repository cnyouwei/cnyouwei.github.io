{# Shared shell; page metadata and dependency configuration come from the builder. #}
<!DOCTYPE html>
<html lang="en" data-page="{{ page_id }}">
<head>
  <meta charset="utf-8" />
  {# The policy governs only content that follows it. #}
  <meta http-equiv="Content-Security-Policy" content="{{ content_security_policy }}" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}" />
  {% if not page_indexed %}<meta name="robots" content="noindex" />{% endif %}
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <link rel="canonical" href="{{ page_url }}" />
  <meta property="og:type" content="{{ 'article' if page_id == 'blog-post' else 'website' }}" />
  <meta property="og:site_name" content="{{ profile.site.title }}" />
  <meta property="og:title" content="{{ page_title }}" />
  <meta property="og:description" content="{{ page_description }}" />
  <meta property="og:url" content="{{ page_url }}" />
  <meta property="og:image" content="{{ share_image_url }}" />
  <meta property="og:image:width" content="{{ profile.avatar.width }}" />
  <meta property="og:image:height" content="{{ profile.avatar.height }}" />
  <meta property="og:image:alt" content="{{ profile.avatar.alt }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ page_title }}" />
  <meta name="twitter:description" content="{{ page_description }}" />
  <meta name="twitter:image" content="{{ share_image_url }}" />
  <meta name="twitter:image:alt" content="{{ profile.avatar.alt }}" />
  <link rel="icon" type="image/svg+xml" href="{{ root }}favicon.svg?v={{ asset_versions['favicon.svg'] }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {# Fraunces: serif display headings. Inter: body/UI (stable rendering everywhere). #}
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  {% if page_id == 'home' %}
  {# The only CJK on the site is the name "尤为" (home only); subset to those glyphs. #}
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;700&text=%E5%B0%A4%E4%B8%BA&display=swap" rel="stylesheet" />
  {% endif %}
  <script>{{ theme_init_js }}</script>
  <link rel="stylesheet" href="{{ root }}css/site.css?v={{ asset_versions['css/site.css'] }}" />
  {% if page_id == 'blog-post' %}
  <link rel="stylesheet" href="{{ root }}css/blog.css?v={{ asset_versions['css/blog.css'] }}" />
  {% endif %}
  <script id="site-config" type="application/json">{{ runtime_config | tojson }}</script>
  {% if page_id == 'home' %}
  <script type="application/ld+json">{{ person_json | tojson }}</script>
  {% endif %}
{% block head_extra %}{% endblock %}
</head>
<body>
  <div id="top"></div>
  <a class="skip-link" href="#main">Skip to content</a>
{% include 'partials/nav.html.j2' %}
  <main id="main" tabindex="-1">
{% block main %}{% endblock %}
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <p>&copy; {{ build_year }} {{ profile.name }}</p>
      <p>{{ profile.site.footer_affiliation }}</p>
    </div>
  </footer>
  <a class="back-to-top" href="#top" aria-label="Back to top">Top &uarr;</a>
  <script src="{{ root }}js/site.js?v={{ asset_versions['js/site.js'] }}" defer></script>
{% for src in page_scripts %}
  <script src="{{ root }}js/{{ src }}?v={{ asset_versions['js/' ~ src] }}" defer></script>
{% endfor %}
</body>
</html>
