{% if modules %}
{% for module in modules %}
<article class="module-card card-surface">
  <p class="module-code">{{ module.code }}</p>
  <h3>{{ module.title }}</h3>
  <p>{{ module.description }}</p>
  <a class="button" href="{{ module.url }}" target="_blank" rel="noopener noreferrer">{{ module.link_label }}</a>
</article>
{% endfor %}
{% else %}
<article class="module-card card-surface"><h3>No modules published yet</h3><p>Materials will be added here when available.</p></article>
{% endif %}
