<section class="module-section reveal-up delay-1" aria-label="Teaching courses">
  <div class="module-grid">
{% if courses %}
{% for course in courses %}
    <article class="module-card course-card card-surface">
      <p class="timeline-year">{{ course.period }}</p>
      <p class="course-institution">{{ course.institution }}</p>
      <p class="course-status {{ course.status_class }}">{{ course.status }}</p>
      <h3>{{ course.heading }}</h3>
      <p>{{ course.summary }}</p>
{% if course.published %}
      <a class="button" href="teaching/{{ course.slug }}.html">Open course page</a>
{% else %}
      <p class="muted">Course page coming soon.</p>
{% endif %}
    </article>
{% endfor %}
{% else %}
    <article class="module-card course-card card-surface">
      <h3>No courses yet</h3>
      <p>Add entries to <code>content/teaching/courses.json</code> and rebuild.</p>
    </article>
{% endif %}
  </div>
</section>
