<article class="{{ paper.paper_class }} card-surface" data-type="{{ paper.paper_type }}" data-year="{{ paper.year }}" data-topic="{{ paper.topic }}"{% if paper.has_abstract %} tabindex="0" role="button" aria-expanded="false"{% endif %}>
  <div class="paper-header">
    <span class="paper-year">{{ paper.year }}</span>
    <span class="badge {{ paper.badge_class }}">{{ paper.badge }}</span>
  </div>
  <h4 class="paper-title">{{ paper.title }}</h4>
  <p class="paper-meta">{{ paper.authors_html }}{% if paper.note %}, {{ paper.note }}{% endif %}</p>
{% if paper.venue %}
  <p class="paper-venue"><em>{{ paper.venue }}</em></p>
{% endif %}
{% if paper.links %}
  <div class="paper-links">
{% for link in paper.links %}
    <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
{% endfor %}
  </div>
{% endif %}
{% if paper.has_abstract %}
  <div class="paper-abstract" hidden>
{% for paragraph in paper.abstract_paragraphs %}
    <p>{{ paragraph }}</p>
{% endfor %}
  </div>
{% endif %}
</article>
