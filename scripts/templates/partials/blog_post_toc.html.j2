<aside class="panel post-toc card-surface" aria-label="Table of contents">
  <p class="post-toc__title">On this page</p>
  <nav class="post-toc__nav">
    <ol>
{% for item in toc_items %}
      <li class="{{ item.item_class }}"><a class="post-toc__link" href="#{{ item.heading_id }}">{{ item.title }}</a></li>
{% endfor %}
    </ol>
  </nav>
</aside>
