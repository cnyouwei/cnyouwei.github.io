  <main class="teaching-page">
    <section class="container teaching-shell">
      <header class="course-hero reveal-up">
        <p class="eyebrow">{{ course_institution }}</p>
        <h1>{{ course_heading }}</h1>
        <p class="course-lead">{{ course_overview }}</p>
        <div class="hero-links">
          <a class="chip" href="./index.html">All Course Pages</a>
          <a class="chip" href="../index.html#teaching">Main Site Teaching Section</a>
        </div>
      </header>

      <section class="course-snapshot reveal-up delay-1" aria-label="Course snapshot">
        <article class="panel">
          <h2>Course Snapshot</h2>
          <ul class="stack-list">
            <li><strong>Institution:</strong> {{ course_institution }}</li>
            <li><strong>Period:</strong> {{ course_period }}</li>
            <li><strong>Audience:</strong> {{ course_audience }}</li>
            <li><strong>Prerequisites:</strong> {{ course_prerequisites }}</li>
          </ul>
        </article>
        <article class="panel">
          <h2>Learning Outcomes</h2>
          <ul class="stack-list">
{{ outcomes_items_html }}
          </ul>
        </article>
      </section>

      <section class="module-section reveal-up delay-2" aria-label="Lecture modules">
        <header class="section-header">
          <p class="eyebrow">Lecture Modules</p>
          <h2>Materials</h2>
        </header>
        <div class="module-grid">
{{ modules_html }}
        </div>
      </section>
    </section>
  </main>
