{%- set asset_prefix = '../' if subpage else '' -%}
{%- set nav_prefix = '../index.html' if subpage else '' -%}
{%- set js_prefix = asset_prefix ~ 'js/' -%}
{%- set css_href = asset_prefix ~ 'css/site.css' -%}
<!DOCTYPE html>
<html lang="en" data-ga-id="{{ ga_id }}" data-page="{{ page_id }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ meta_description }}" />
{% include 'partials/head_assets.html.j2' %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
{% include 'partials/nav.html.j2' %}
{{ main_html }}
{% include 'partials/footer.html.j2' %}
{% include 'partials/mathjax.html.j2' %}
  <script src="{{ js_prefix }}site.js" defer></script>
{% for src in page_scripts %}  <script src="{{ js_prefix }}{{ src }}" defer></script>
{% endfor %}</body>
</html>
